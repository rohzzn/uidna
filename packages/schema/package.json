{
  "name": "@rohzzn/uidna-schema",
  "version": "0.1.0",
  "description": "The UI DNA document schema: Zod schema, JSON Schema and TypeScript types for describing a user interface down to the token, the component and the state transition, with provenance on every value.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./ui-dna.schema.json": "./dist/ui-dna.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/scripts/json-schema.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit packages/schema"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "ui",
    "schema",
    "design-tokens",
    "reverse-engineering",
    "zod",
    "json-schema"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rohzzn/uidna",
    "directory": "packages/schema"
  },
  "publishConfig": {
    "access": "public"
  }
}
